generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Registration {
  id         String   @id @default(cuid())
  firstName  String
  lastName   String
  email      String
  vegetarian Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([createdAt])
}
